<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="NPOI" Version="2.7.6" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../ProductFinder/Models/*.cs" Link="Models/%(Filename)%(Extension)"/>
    <Compile Include="../ProductFinder/Infrastructure/*.cs" Link="Infrastructure/%(Filename)%(Extension)"/>
    <Compile Include="../ProductFinder/Services/*.cs" Exclude="../ProductFinder/Services/WindowDialogService.cs" Link="Services/%(Filename)%(Extension)"/>
    <Compile Include="../ProductFinder/ViewModels/*.cs" Exclude="../ProductFinder/ViewModels/ExcelImportViewModel.cs" Link="ViewModels/%(Filename)%(Extension)"/>
  </ItemGroup>
  <ItemGroup><None Update="*-parity.json" CopyToOutputDirectory="PreserveNewest"/><None Update="fixture.db" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><None Include="../ProductFinder/Views/MainWindow.xaml" Link="MainWindow-binding-check.xaml" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
