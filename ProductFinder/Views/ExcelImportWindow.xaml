<Window x:Class="ProductFinder.Views.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт заявки из Excel" Width="1280" Height="820" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        Foreground="#17243A" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Импорт заявки" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="FileNameText" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16" IsEnabled="{Binding CanConfigure, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Лист" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Sheets, Mode=OneWay}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" MinHeight="44" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Строка заголовка" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding HeaderRowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" MaxLength="3" AutomationProperties.Name="Строка заголовка"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Применить" Command="{Binding ApplyHeaderCommand, Mode=OneWay}" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding CanConfigure, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Артикул" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Columns, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding ArticleColumn, Mode=TwoWay}" MinHeight="44" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Название" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding NameColumns, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding NameColumn, Mode=TwoWay}" MinHeight="44" Padding="10,6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Количество" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Columns, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding QuantityColumn, Mode=TwoWay}" MinHeight="44" Padding="10,6"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12" IsEnabled="{Binding CanConfigure, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FilterTextBox" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" ToolTip="Фильтр по артикулу, названию или исходной строке" AutomationProperties.Name="Фильтр строк Excel"/>
            <Button Grid.Column="1" Content="Выделить все" Command="{Binding SelectAllCommand, Mode=OneWay}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Снять все" Command="{Binding DeselectAllCommand, Mode=OneWay}" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="Инверсия" Command="{Binding InvertChecksCommand, Mode=OneWay}"/>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <DataGrid x:Name="RowsGrid" ItemsSource="{Binding RowsView, Mode=OneWay}" IsEnabled="{Binding CanConfigure, Mode=OneWay}" AutomationProperties.Name="Строки для импорта">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="44" Height="44" HorizontalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" AutomationProperties.Name="Импортировать строку"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Строка" Binding="{Binding SourceRow, Mode=OneWay}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Колонка" Binding="{Binding ColumnLetter, Mode=OneWay}" Width="75" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Article, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="170" ElementStyle="{StaticResource ArticleText}" EditingElementStyle="{StaticResource ImportEditor}"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource ImportEditor}"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="85" ElementStyle="{StaticResource QuantityText}" EditingElementStyle="{StaticResource QuantityEditor}"/>
                        <DataGridTextColumn Header="Исходная строка" Binding="{Binding SourceText, Mode=OneWay}" Width="2*" MinWidth="230" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="#DDF4F6FA" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,12,0,0" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                <TextBlock Text="Фильтр не снимает отметки со скрытых строк" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Импортировать выбранные" IsEnabled="{Binding CanAccept, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Click="Import_Click"/>
        </Grid>
    </Grid>
</Window>
