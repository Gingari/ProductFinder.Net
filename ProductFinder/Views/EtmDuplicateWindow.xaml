<Window x:Class="ProductFinder.Views.EtmDuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Артикул уже есть в каталоге" Width="900" Height="560" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14" Foreground="#17243A">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Артикул уже есть в каталоге" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Foreground="#526176"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Получено с ЭТМ" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Article, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneWay}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Manufacturer, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Manufacturer, Mode=OneWay}" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <DataGrid x:Name="ExistingGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ExistingGrid_SelectionChanged" AutomationProperties.Name="Существующие записи артикула">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article, Mode=OneWay}" Width="160" ElementStyle="{StaticResource ArticleText}"/>
                    <DataGridTextColumn Header="Название в каталоге" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="250" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer, Mode=OneWay}" Width="160" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="KeepButton" Content="Оставить существующую" Click="Keep_Click" Margin="0,0,10,0"/>
            <Button x:Name="ReplaceButton" Content="Заменить выбранную" Style="{StaticResource PrimaryButton}" Click="Replace_Click"/>
        </StackPanel>
    </Grid>
</Window>
