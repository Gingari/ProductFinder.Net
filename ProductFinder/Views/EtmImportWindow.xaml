<Window x:Class="ProductFinder.Views.EtmImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Допарсить на ЭТМ" Width="1120" Height="850" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA" Foreground="#17243A" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid MinHeight="680" Height="{Binding ViewportHeight, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Допарсить на ЭТМ" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Подтвердите запрос → выберите товар → проверьте карточку → сохраните в каталог" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Запрос из заявки — можно изменить перед поиском" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,0,0,8"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit, Mode=OneWay}" MaxLength="500" AutomationProperties.Name="Название товара для поиска на ЭТМ" Margin="0,0,12,0"/>
                    <Button Grid.Column="1" Content="Найти на ЭТМ" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand, Mode=OneWay}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Открыть браузер" Command="{Binding ShowBrowserCommand, Mode=OneWay}"/>
                </Grid>
                <CheckBox Grid.Row="2" Content="Без окна браузера · Edge не обязателен" MinHeight="44" IsChecked="{Binding UseBackground, Mode=TwoWay}" IsEnabled="{Binding CanEdit, Mode=OneWay}" Margin="0,4,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status, Mode=OneWay}" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="Остановить" Command="{Binding CancelCommand, Mode=OneWay}" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" MinHeight="32" Padding="12,5"/>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="10,4,10,12">
                    <TextBlock Text="Результаты ЭТМ" Style="{StaticResource SectionTitle}"/>
                    <Button Content="Отпарсить" Command="{Binding ParseCommand, Mode=OneWay}" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" MinHeight="44" Padding="14,6"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Results, Mode=OneWay}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanEdit, Mode=OneWay}" IsReadOnly="True" SelectionMode="Single" AutomationProperties.Name="Результаты поиска ЭТМ">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название товара" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="320" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer, Mode=OneWay}" Width="170" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="Ссылка / карточка" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="{Binding LinkLabel, Mode=OneWay}" ToolTip="{Binding Url, Mode=OneWay}" Click="CandidateLink_Click" Margin="6,0" MinHeight="44" Padding="8,0"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" Visibility="{Binding HasParsedProduct, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Проверьте данные перед записью в каталог" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="{Binding ParsedProduct.Name, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParsedProduct.Name, Mode=OneWay}" Margin="0,0,0,10"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Артикул производителя" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,0,0,5"/><TextBox Text="{Binding ParsedProduct.Article, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Производитель" Style="{StaticResource SecondaryText}" Foreground="#526176" Margin="0,0,0,5"/><TextBox Text="{Binding ParsedProduct.Manufacturer, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding ParsedProduct.Url, Mode=OneWay}" Style="{StaticResource SecondaryText}" Foreground="#526176" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParsedProduct.Url, Mode=OneWay}" Margin="0,8,0,0"/>
            </Grid>
        </Border>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="SQLite обновляется только после подтверждения. Перед записью создаётся резервная копия." Style="{StaticResource SecondaryText}" Foreground="#526176" TextWrapping="Wrap" MaxWidth="490" Margin="0,0,20,0"/>
            <Button Grid.Column="1" Content="Закрыть" Click="Close_Click" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Сохранить и добавить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>
