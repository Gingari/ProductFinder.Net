<Window x:Class="ProductFinder.Views.QuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить товар" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        Foreground="#17243A" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ProductNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Количество" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
            <TextBox x:Name="QuantityTextBox" Text="1" MaxLength="6" TextAlignment="Center" AutomationProperties.Name="Количество"/>
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#A62F46" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
