<Window x:Class="ProductFinder.Views.CandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбрать другой вариант" Width="1080" Height="620" MinWidth="880" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6FA"
        Foreground="#17243A" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Варианты товара" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <DataGrid x:Name="CandidatesGrid" RowStyle="{StaticResource MatchRowStyle}" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CandidatesGrid_SelectionChanged" MouseDoubleClick="CandidatesGrid_MouseDoubleClick" AutomationProperties.Name="Варианты товара">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="170" ElementStyle="{StaticResource ArticleText}"/>
                    <DataGridTextColumn Header="Название товара" Binding="{Binding Name}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="165" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="Совпадение" Width="150" IsReadOnly="True" SortMemberPath="Score" CellTemplate="{StaticResource MatchCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="ConfirmButton" Content="Выбрать" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
